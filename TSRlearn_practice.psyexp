        <Param val="bids.schedule_onset(instruction_part12, {&quot;type_of_stimulus&quot;: &quot;instructions&quot;, &quot;component_label&quot;: &quot;instruction_part12&quot;});&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
