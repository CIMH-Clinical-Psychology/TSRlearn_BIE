      </TextComponent>
      <CodeComponent name="text_question_retrieval_prc" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    if ((trial_type === 1)) {&amp;#10;        question_retrieval_prc.text = &quot;Please indicate whether the following two images appeared in this order in the learned sequence. If yes, press the left arrow key. If no, press the right arrow key.\n[Press the return key to continue.]&quot;;&amp;#10;    }&amp;#10;    if ((trial_type === 2)) {&amp;#10;        question_retrieval_prc.text = &quot;You will see one image and then a pair of images. Please indicate which image from the pair is closer to the image presented first. Respond with the left and right arrow key.\n[Press the return key to continue.]&quot;;&amp;#10;    }&amp;#10;    if ((trial_type === 3)) {&amp;#10;        question_retrieval_prc.text = &quot;You will see two images. Please indicate how many images lie between them in the learned sequence. Use the left and right arrow keys to move the slider, and press Return to confirm your response.\n[Press the return key to continue.]&quot;;&amp;#10;    }&amp;#10;}&amp;#10;if ((language === &quot;french&quot;)) {&amp;#10;    if ((trial_type === 1)) {&amp;#10;        question_retrieval_prc.text = &quot;Veuillez indiquer si les deux images suivantes sont apparues dans cet ordre dans la s\u00e9quence apprise. Si oui, appuyez sur la fl\u00e8che gauche. Si non, appuyez sur la fl\u00e8che droite.\n[Appuyez sur la touche Entr\u00e9e pour continuer.]&quot;;&amp;#10;    }&amp;#10;    if ((trial_type === 2)) {&amp;#10;        question_retrieval_prc.text = &quot;Vous verrez d\u2019abord une image, puis une paire d\u2019images. Veuillez indiquer laquelle des deux images est la plus proche de l\u2019image pr\u00e9sent\u00e9e en premier. R\u00e9pondez \u00e0 l\u2019aide des fl\u00e8ches gauche et droite.\n[Appuyez sur la touche Entr\u00e9e pour continuer.]&quot;;&amp;#10;    }&amp;#10;    if ((trial_type === 3)) {&amp;#10;        question_retrieval_prc.text = &quot;Vous verrez deux images. Veuillez indiquer combien d\u2019images se trouvent entre elles dans la s\u00e9quence apprise. D\u00e9placez le curseur \u00e0 l\u2019aide des fl\u00e8ches gauche et droite. Validez votre r\u00e9ponse avec la touche Entr\u00e9e.\n[Appuyez sur la touche Entr\u00e9e pour continuer.]&quot;;&amp;#10;    }&amp;#10;}&amp;#10;if ((language === &quot;german&quot;)) {&amp;#10;    if ((trial_type === 1)) {&amp;#10;        question_retrieval_prc.text = &quot;Bitte geben Sie an, ob die folgenden beiden Bilder in dieser Reihenfolge in der gelernten Reihenfolge vorkamen.Wenn ja, dr\u00fccken Sie die linke Pfeiltaste. Wenn nein, dr\u00fccken Sie die rechte Pfeiltaste.\n[Dr\u00fccke Sie die Eingabetaste, um weiterzumachen.] &quot;;&amp;#10;    }&amp;#10;    if ((trial_type === 2)) {&amp;#10;        question_retrieval_prc.text = &quot;Sie sehen ein Bilder und zwei weitere. Bitte geben Sie an, welches der beiden Bilder n\u00e4her an dem zuerst pr\u00e4sentierten Bild liegt. Antworten Sie mit der linken und rechten Pfeiltaste.\n[Dr\u00fccke Sie die Eingabetaste, um weiterzumachen.] &quot;;&amp;#10;    }&amp;#10;    if ((trial_type === 3)) {&amp;#10;        question_retrieval_prc.text = &quot;Sie werden zwei Bilder sehen. Bitte geben Sie an, wie viele Bilder in der gelernten Reihenfolge zwischen diesen beiden liegen. Bewegen Sie den Slider mit den Pfeiltasten. Loggen Sie ihre Antwort mit der Eingabetaste ein.\n[Dr\u00fccke Sie die Eingabetaste, um weiterzumachen.] &quot;;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if language==&quot;english&quot;: &amp;#10;&amp;#10;    if trial_type == 1: &amp;#10;        question_retrieval_prc.text = (&amp;#10;        &quot;Please indicate whether the following two images appeared in this order in the learned sequence. &quot;&amp;#10;        &quot;If yes, press the left arrow key. If no, press the right arrow key.\n&quot;&amp;#10;        &quot;[Press the return key to continue.]&quot;&amp;#10;     )&amp;#10;    if trial_type == 2:&amp;#10;        question_retrieval_prc.text = (&amp;#10;        &quot;You will see one image and then a pair of images. Please indicate which image from the pair is &quot;&amp;#10;        &quot;closer to the image presented first. Respond with the left and right arrow key.\n&quot;&amp;#10;        &quot;[Press the return key to continue.]&quot;&amp;#10;       )&amp;#10;    if trial_type==3:&amp;#10;       question_retrieval_prc.text = (&amp;#10;       &quot;You will see two images. Please indicate how many images lie between them in the learned sequence. &quot;&amp;#10;       &quot;Use the left and right arrow keys to move the slider, and press Return to confirm your response.\n&quot;&amp;#10;        &quot;[Press the return key to continue.]&quot;&amp;#10;   )&amp;#10;&amp;#10;if language == &quot;french&quot;:&amp;#10;&amp;#10;    if trial_type == 1:&amp;#10;        question_retrieval_prc.text = (&amp;#10;        &quot;Veuillez indiquer si les deux images suivantes sont apparues dans cet ordre &quot;&amp;#10;        &quot;dans la séquence apprise. &quot;&amp;#10;        &quot;Si oui, appuyez sur la flèche gauche. Si non, appuyez sur la flèche droite.\n&quot;&amp;#10;        &quot;[Appuyez sur la touche Entrée pour continuer.]&quot;&amp;#10;        )&amp;#10;&amp;#10;    if trial_type == 2:&amp;#10;        question_retrieval_prc.text = (&amp;#10;        &quot;Vous verrez d’abord une image, puis une paire d’images. &quot;&amp;#10;        &quot;Veuillez indiquer laquelle des deux images est la plus proche &quot;&amp;#10;        &quot;de l’image présentée en premier. &quot;&amp;#10;        &quot;Répondez à l’aide des flèches gauche et droite.\n&quot;&amp;#10;        &quot;[Appuyez sur la touche Entrée pour continuer.]&quot;&amp;#10;        )&amp;#10;&amp;#10;    if trial_type == 3:&amp;#10;        question_retrieval_prc.text = (&amp;#10;        &quot;Vous verrez deux images. &quot;&amp;#10;        &quot;Veuillez indiquer combien d’images se trouvent entre elles &quot;&amp;#10;        &quot;dans la séquence apprise. &quot;&amp;#10;        &quot;Déplacez le curseur à l’aide des flèches gauche et droite. &quot;&amp;#10;        &quot;Validez votre réponse avec la touche Entrée.\n&quot;&amp;#10;        &quot;[Appuyez sur la touche Entrée pour continuer.]&quot;&amp;#10;        )&amp;#10;&amp;#10;if language==&quot;german&quot;: &amp;#10;&amp;#10;    if trial_type == 1: &amp;#10;        question_retrieval_prc.text = (&amp;#10;        &quot;Bitte geben Sie an, ob die folgenden beiden Bilder in dieser Reihenfolge in der gelernten Reihenfolge vorkamen.&quot;&amp;#10;        &quot;Wenn ja, drücken Sie die linke Pfeiltaste. Wenn nein, drücken Sie die rechte Pfeiltaste.\n&quot;&amp;#10;        &quot;[Drücke Sie die Eingabetaste, um weiterzumachen.] &quot;&amp;#10;        )&amp;#10;    if trial_type == 2:&amp;#10;        question_retrieval_prc.text = (&amp;#10;        &quot;Sie sehen ein Bilder und zwei weitere. Bitte geben Sie an, welches der beiden Bilder näher an dem &quot;&amp;#10;        &quot;zuerst präsentierten Bild liegt. &quot;&amp;#10;        &quot;Antworten Sie mit der linken und rechten Pfeiltaste.\n&quot;&amp;#10;        &quot;[Drücke Sie die Eingabetaste, um weiterzumachen.] &quot;&amp;#10;        )&amp;#10;    if trial_type==3:&amp;#10;       question_retrieval_prc.text = (&amp;#10;       &quot;Sie werden zwei Bilder sehen. Bitte geben Sie an, wie viele Bilder in der gelernten Reihenfolge zwischen diesen beiden liegen. &quot;&amp;#10;        &quot;Bewegen Sie den Slider mit den Pfeiltasten. &quot; &amp;#10;        &quot;Loggen Sie ihre Antwort mit der Eingabetaste ein.\n&quot;&amp;#10;        &quot;[Drücke Sie die Eingabetaste, um weiterzumachen.] &quot;&amp;#10;        )" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="text_question_retrieval_prc" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <KeyboardComponent name="continue_button_7" plugin="None">
        <Param val="&quot;return&quot;" valType="list" updates="constant" name="allowedKeys"/>
        <Param val="" valType="str" updates="constant" name="correctAns"/>
        <Param val="" valType="str" updates="None" name="deviceLabel"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="True" valType="bool" updates="constant" name="discard previous"/>
