      <CodeComponent name="instruction_part12" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    instruction_part12.text = &quot;Second question: the DISTANCE.\n\nHow many positions apart are the two images in the learned sequence?\n\nThe distance is the number of steps it takes to get from one image to the other along the sequence. It does not depend on the order in which the two images were shown to you \u2013 the distance is the same either way.\nPossible answers are 2, 3, 4 or 5 steps.\n\n[Press the return key to continue.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;german&quot;)) {&amp;#10;    instruction_part12.text = &quot;Zweite Frage: der ABSTAND.\n\nWie viele Positionen liegen die beiden Bilder in der gelernten Sequenz auseinander?\n\nDer Abstand ist die Anzahl der Schritte, die man ben\u00f6tigt, um in der Sequenz von einem Bild zum anderen zu gelangen. Er h\u00e4ngt nicht davon ab, in welcher Reihenfolge die beiden Bilder gezeigt wurden \u2013 der Abstand ist in beide Richtungen gleich.\nM\u00f6gliche Antworten sind 2, 3, 4 oder 5 Schritte.\n\n[Dr\u00fccken Sie die Eingabetaste, um weiterzumachen.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;french&quot;)) {&amp;#10;    instruction_part12.text = &quot;Deuxi\u00e8me question\u00a0: la DISTANCE.\n\nCombien de positions s\u00e9parent les deux images dans la s\u00e9quence apprise\u00a0?\n\nLa distance correspond au nombre de pas n\u00e9cessaires pour aller d\u2019une image \u00e0 l\u2019autre le long de la s\u00e9quence. Elle ne d\u00e9pend pas de l\u2019ordre dans lequel les deux images vous ont \u00e9t\u00e9 pr\u00e9sent\u00e9es\u00a0: la distance est la m\u00eame dans les deux sens.\nLes r\u00e9ponses possibles sont 2, 3, 4 ou 5 pas.\n\n[Appuyez sur la touche Entr\u00e9e pour continuer.]&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if language == &quot;english&quot;:&amp;#10;    instruction_part12.text = (&amp;#10;        &quot;Second question: the DISTANCE.\n\n&quot;&amp;#10;        &quot;How many positions apart are the two images in the learned &quot;&amp;#10;        &quot;sequence?\n\n&quot;&amp;#10;        &quot;The distance is the number of steps it takes to get from one image &quot;&amp;#10;        &quot;to the other along the sequence. It does not depend on the order in &quot;&amp;#10;        &quot;which the two images were shown to you \u2013 the distance is the &quot;&amp;#10;        &quot;same either way.\n&quot;&amp;#10;        &quot;Possible answers are 2, 3, 4 or 5 steps.\n\n&quot;&amp;#10;        &quot;[Press the return key to continue.]&quot;&amp;#10;    )&amp;#10;&amp;#10;if language == &quot;german&quot;:&amp;#10;    instruction_part12.text = (&amp;#10;        &quot;Zweite Frage: der ABSTAND.\n\n&quot;&amp;#10;        &quot;Wie viele Positionen liegen die beiden Bilder in der gelernten &quot;&amp;#10;        &quot;Sequenz auseinander?\n\n&quot;&amp;#10;        &quot;Der Abstand ist die Anzahl der Schritte, die man benötigt, um in &quot;&amp;#10;        &quot;der Sequenz von einem Bild zum anderen zu gelangen. Er hängt nicht &quot;&amp;#10;        &quot;davon ab, in welcher Reihenfolge die beiden Bilder gezeigt wurden &quot;&amp;#10;        &quot;\u2013 der Abstand ist in beide Richtungen gleich.\n&quot;&amp;#10;        &quot;Mögliche Antworten sind 2, 3, 4 oder 5 Schritte.\n\n&quot;&amp;#10;        &quot;[Drücken Sie die Eingabetaste, um weiterzumachen.]&quot;&amp;#10;    )&amp;#10;&amp;#10;if language == &quot;french&quot;:&amp;#10;    instruction_part12.text = (&amp;#10;        &quot;Deuxième question\u00a0: la DISTANCE.\n\n&quot;&amp;#10;        &quot;Combien de positions séparent les deux images dans la séquence &quot;&amp;#10;        &quot;apprise\u00a0?\n\n&quot;&amp;#10;        &quot;La distance correspond au nombre de pas nécessaires pour aller &quot;&amp;#10;        &quot;d\u2019une image à l\u2019autre le long de la séquence. Elle ne &quot;&amp;#10;        &quot;dépend pas de l\u2019ordre dans lequel les deux images vous ont été &quot;&amp;#10;        &quot;présentées\u00a0: la distance est la même dans les deux sens.\n&quot;&amp;#10;        &quot;Les réponses possibles sont 2, 3, 4 ou 5 pas.\n\n&quot;&amp;#10;        &quot;[Appuyez sur la touche Entrée pour continuer.]&quot;&amp;#10;    )" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
