        <Param val="bids.schedule_onset(instruction_part1, {&quot;trial_type&quot;: &quot;instruction&quot;, &quot;type_of_stimulus&quot;: &quot;instruction_text&quot;, &quot;component_label&quot;: &quot;instruction_part1&quot;});&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
