        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    instruction_part13.text = &quot;A few last points.\n\nOnce a question is on the screen, answer as QUICKLY and as ACCURATELY as possible.\nIf you are unsure, give your best guess, do not skip the question.\n\n[Press Enter to continue.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;german&quot;)) {&amp;#10;    instruction_part13.text = &quot;Noch einige Hinweise.\n\nSobald eine Frage auf dem Bildschirm steht, antworten Sie so SCHNELL und so GENAU wie m\u00f6glich.\nWenn Sie unsicher sind, antworten Sie nach bestem Wissen.\u00fcberspringen Sie die Frage nicht.\n\n[Dr\u00fccke Sie die Eingabetaste, um weiterzumachen.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;french&quot;)) {&amp;#10;    instruction_part13.text = &quot;Encore quelques remarques.\n\nD\u00e8s qu\u2019une question appara\u00eet \u00e0 l\u2019\u00e9cran, r\u00e9pondez le plus VITE et le plus PR\u00c9CIS\u00c9MENT possible.\nEn cas d\u2019h\u00e9sitation, donnez votre meilleure estimation. Ne sautez pas la question.\n\n[Appuyez sur la touche Entr\u00e9e pour continuer.]&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if language == &quot;english&quot;: &amp;#10;    instruction_part13.text = (&amp;#10;        &quot;A few last points.\n\n&quot;&amp;#10;    &quot;Once a question is on the screen, answer as QUICKLY and as &quot;&amp;#10;    &quot;ACCURATELY as possible.\n&quot;&amp;#10;    &quot;If you are unsure, give your best guess, do not skip the &quot;&amp;#10;    &quot;question.\n\n&quot;&amp;#10;    &quot;[Press Enter to continue.]&quot;&amp;#10;    )&amp;#10;&amp;#10;    &amp;#10;    &amp;#10;if language == &quot;german&quot;: &amp;#10;    instruction_part13.text = (&amp;#10;&quot;Noch einige Hinweise.\n\n&quot;&amp;#10;            &quot;Sobald eine Frage auf dem Bildschirm steht, antworten Sie so &quot;&amp;#10;            &quot;SCHNELL und so GENAU wie möglich.\n&quot;&amp;#10;            &quot;Wenn Sie unsicher sind, antworten Sie nach bestem Wissen.&quot;&amp;#10;            &quot;überspringen Sie die Frage nicht.\n\n&quot;&amp;#10;            &quot;[Drücke Sie die Eingabetaste, um weiterzumachen.]&quot;&amp;#10;)&amp;#10;&amp;#10;if language == &quot;french&quot;:&amp;#10;        instruction_part13.text = (&amp;#10;    &quot;Encore quelques remarques.\n\n&quot;&amp;#10;    &quot;D\u00e8s qu\u2019une question appara\u00eet \u00e0 l\u2019\u00e9cran, &quot;&amp;#10;    &quot;r\u00e9pondez le plus VITE et le plus PR\u00c9CIS\u00c9MENT possible.\n&quot;&amp;#10;    &quot;En cas d\u2019h\u00e9sitation, donnez votre meilleure estimation. &quot;&amp;#10;    &quot;Ne sautez pas la question.\n\n&quot;&amp;#10;    &quot;[Appuyez sur la touche Entr\u00e9e pour continuer.]&quot;&amp;#10;)" valType="extendedCode" updates="constant" name="Begin Routine"/>
