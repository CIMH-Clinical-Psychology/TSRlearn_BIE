      <CodeComponent name="set_sides_options" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="yes_position = (0,0)&amp;#10;no_position=(0,0)&amp;#10;&amp;#10;# place holders" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="yes_position = [0, 0];&amp;#10;no_position = [0, 0];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((opt_left === &quot;yes&quot;)) {&amp;#10;    yes_position = [(- 0.05), 0];&amp;#10;    no_position = [0.05, 0];&amp;#10;}&amp;#10;if ((opt_left === &quot;no&quot;)) {&amp;#10;    yes_position = [0.05, 0];&amp;#10;    no_position = [(- 0.05), 0];&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if opt_left == &quot;yes&quot;:&amp;#10;    yes_position = (-0.05, 0)&amp;#10;    no_position = (0.05, 0)&amp;#10;if opt_left == &quot;no&quot;:&amp;#10;    yes_position = (0.05, 0)&amp;#10;    no_position = (-0.05, 0)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="set_sides_options" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="end_routine_after_resp" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="responded_retr = false;&amp;#10;feedbackClock = null;&amp;#10;routClock = new util.Clock();&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# initialize&amp;#10;responded_retr = False&amp;#10;&amp;#10;feedbackClock = None&amp;#10;&amp;#10;routClock = core.Clock()&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="if resp_prc.keys and not responded_retr:&amp;#10;    responded_retr = True&amp;#10;&amp;#10;    key = resp_prc.keys[-1] if isinstance(resp_prc.keys, list) else resp_prc.keys&amp;#10;    chosen = yes_txt_prc if (yes_position[0] &lt; 0) == (key == left_key) else no_txt_prc&amp;#10;    chosen.color = &quot;green&quot; if key == correct_key else &quot;red&quot;&amp;#10;&amp;#10;&amp;#10;        &amp;#10;&amp;#10;# Each Frame (am Ende):&amp;#10;if responded_retr and feedbackClock is None:&amp;#10;    feedbackClock = routClock.getTime()&amp;#10;if feedbackClock is not None and routClock.getTime() &gt;= feedbackClock + 0.3:&amp;#10;    continueRoutine = False&amp;#10;&amp;#10;if not responded_retr and routClock.getTime() &gt;= retr_dur:&amp;#10;    continueRoutine = False&amp;#10;    &amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((resp_prc.keys &amp;&amp; (! responded_retr))) {&amp;#10;    responded_retr = true;&amp;#10;    key = ((resp_prc.keys instanceof list) ? resp_prc.keys.slice((- 1))[0] : resp_prc.keys);&amp;#10;    chosen = (((yes_position[0] &lt; 0) === (key === left_key)) ? yes_txt_prc : no_txt_prc);&amp;#10;    chosen.color = ((key === correct_key) ? &quot;green&quot; : &quot;red&quot;);&amp;#10;}&amp;#10;if ((responded_retr &amp;&amp; (feedbackClock === null))) {&amp;#10;    feedbackClock = routClock.getTime();&amp;#10;}&amp;#10;if (((feedbackClock !== null) &amp;&amp; (routClock.getTime() &gt;= (feedbackClock + 0.3)))) {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;if (((! responded_retr) &amp;&amp; (routClock.getTime() &gt;= retr_dur))) {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="end_routine_after_resp" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="yes_txt_prc" plugin="None">
        <Param val="white" valType="color" updates="set every repeat" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="False" valType="code" updates="constant" name="draggable"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="None" valType="str" updates="constant" name="flip"/>
