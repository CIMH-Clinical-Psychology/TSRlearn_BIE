        <Param val="if language == &quot;english&quot;:&amp;#10;    tooSlowtext.text = (&amp;#10;        &quot;Too slow. You need to respond faster.&quot;&amp;#10;    )&amp;#10;&amp;#10;if language == &quot;german&quot;:&amp;#10;    tooSlowtext.text = (&amp;#10;        &quot;Zu langsam. Sie müssen schneller antworten.&quot;&amp;#10;    )&amp;#10;&amp;#10;if language == &quot;french&quot;:&amp;#10;    tooSlowtext.text = (&amp;#10;        &quot;Trop lent. Vous devez répondre plus rapidement. &quot;&amp;#10;    )&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
