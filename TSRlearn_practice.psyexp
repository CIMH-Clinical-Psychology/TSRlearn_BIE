        <Param val="&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    instruction_part3.text = &quot;In the learning phases, you will learn sequences of images.\n\nYou will always start with the first image in a sequence.\n\nYour task is to choose the correct next image in the sequence. At the beginning, you will not yet know the correct pairings.\n\n[Press the return key to continue.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;german&quot;)) {&amp;#10;    instruction_part3.text = &quot;In den Lernphasen lernen Sie Bildsequenzen kennen.\n\nSie beginnen immer mit dem ersten Bild einer Sequenz.\n\nIhre Aufgabe ist es, das richtige n\u00e4chste Bild in der Sequenz auszuw\u00e4hlen.\nZu Beginn kennen Sie die richtigen Paare noch nicht.\n\n[Dr\u00fccken Sie die Eingabetaste, um fortzufahren.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;french&quot;)) {&amp;#10;    instruction_part3.text = &quot;Au cours des phases d'apprentissage, vous apprendrez des s\u00e9quences d'images.\n\nVous commencerez toujours par la premi\u00e8re image d'une s\u00e9quence.\n\nVotre t\u00e2che consiste \u00e0 choisir l'image suivante correcte dans la s\u00e9quence. Au d\u00e9but, vous ne conna\u00eetrez pas encore les associations correctes.\n\n[Appuyez sur la touche Entr\u00e9e pour continuer.]&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if language == &quot;english&quot;: &amp;#10;    instruction_part3.text = (&amp;#10;&quot;In the learning phases, you will learn sequences of &quot;&amp;#10;&quot;images.\n\n&quot;&amp;#10;&quot;You will always start with the first image in a sequence.\n\n&quot;&amp;#10;&quot;Your task is to choose the correct next image in the sequence. &quot;&amp;#10;&quot;At the beginning, you will not yet know the correct pairings.\n\n&quot;&amp;#10;&quot;[Press the return key to continue.]&quot;&amp;#10;)&amp;#10;&amp;#10;   &amp;#10;if language == &quot;german&quot;: &amp;#10;    instruction_part3.text = (&amp;#10;&quot;In den Lernphasen lernen Sie Bildsequenzen kennen.\n\n&quot;&amp;#10;&quot;Sie beginnen immer mit dem ersten Bild einer Sequenz.\n\n&quot;&amp;#10;&quot;Ihre Aufgabe ist es, das richtige nächste Bild in der Sequenz auszuwählen.\n&quot;&amp;#10;&quot;Zu Beginn kennen Sie die richtigen Paare noch nicht.\n\n&quot;&amp;#10;&quot;[Drücken Sie die Eingabetaste, um fortzufahren.]&quot;&amp;#10;)&amp;#10;&amp;#10;if language == &quot;french&quot;:&amp;#10;    instruction_part3.text = (&amp;#10;&quot;Au cours des phases d'apprentissage, vous apprendrez des séquences d'images.\n\n&quot;&amp;#10;&quot;Vous commencerez toujours par la première image d'une séquence.\n\n&quot;&amp;#10;&quot;Votre tâche consiste à choisir l'image suivante correcte dans la séquence. &quot;&amp;#10;&quot;Au début, vous ne connaîtrez pas encore les associations correctes.\n\n&quot;&amp;#10;&quot;[Appuyez sur la touche Entrée pour continuer.]&quot;)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
