      <CodeComponent name="instruction_part9_text" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    instruction_part9.text = &quot;On each trial you will see two images from the sequence, one after the other.\n\nA fixation cross then appears. Use this time to bring both images back to mind and to think about where they sit in the sequence you learned.\n\nAfter that, you will answer two questions about them.\n\n[Press the return key to continue.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;german&quot;)) {&amp;#10;    instruction_part9.text = &quot;In jedem Durchgang sehen Sie zwei Bilder aus der Sequenz, eines nach dem anderen.\n\nAnschlie\u00dfend erscheint ein Fixationskreuz. Nutzen Sie diese Zeit, um sich beide Bilder wieder ins Ged\u00e4chtnis zu rufen und dar\u00fcber nachzudenken, an welcher Stelle sie in der gelernten Sequenz stehen.\n\nDanach beantworten Sie zwei Fragen zu den beiden Bildern.\n\n[Dr\u00fccke Sie die Eingabetaste, um weiterzumachen.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;french&quot;)) {&amp;#10;    instruction_part9.text = &quot;\u00c0 chaque essai, vous verrez deux images de la s\u00e9quence, l\u2019une apr\u00e8s l\u2019autre.\n\nUne croix de fixation appara\u00eetra ensuite. Profitez de ce moment pour vous rem\u00e9morer les deux images et pour penser \u00e0 leur place dans la s\u00e9quence que vous avez apprise.\n\nVous r\u00e9pondrez ensuite \u00e0 deux questions \u00e0 leur sujet.\n\n[Appuyez sur la touche Entr\u00e9e pour continuer.]&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if language == &quot;english&quot;: &amp;#10;    instruction_part9.text = (&amp;#10;    &quot;On each trial you will see two images from the sequence, one after &quot;&amp;#10;            &quot;the other.\n\n&quot;&amp;#10;            &quot;A fixation cross then appears. Use this time to bring both images &quot;&amp;#10;            &quot;back to mind and to think about where they sit in the sequence you &quot;&amp;#10;            &quot;learned.\n\n&quot;&amp;#10;            &quot;After that, you will answer two questions about them.\n\n&quot;&amp;#10;    &quot;[Press the return key to continue.]&quot;&amp;#10;    )&amp;#10;&amp;#10;    &amp;#10;    &amp;#10;if language == &quot;german&quot;: &amp;#10;    instruction_part9.text = (&amp;#10; &quot;In jedem Durchgang sehen Sie zwei Bilder aus der Sequenz, eines nach &quot;&amp;#10;            &quot;dem anderen.\n\n&quot;&amp;#10;            &quot;Anschließend erscheint ein Fixationskreuz. Nutzen Sie diese Zeit, um &quot;&amp;#10;            &quot;sich beide Bilder wieder ins Gedächtnis zu rufen und darüber &quot;&amp;#10;            &quot;nachzudenken, an welcher Stelle sie in der gelernten Sequenz &quot;&amp;#10;            &quot;stehen.\n\n&quot;&amp;#10;            &quot;Danach beantworten Sie zwei Fragen zu den beiden Bildern.\n\n&quot;&amp;#10;            &quot;[Drücke Sie die Eingabetaste, um weiterzumachen.]&quot;&amp;#10;)&amp;#10;&amp;#10;if language == &quot;french&quot;:&amp;#10;    instruction_part9.text = (&amp;#10;        &quot;À chaque essai, vous verrez deux images de la séquence, l\u2019une &quot;&amp;#10;        &quot;après l\u2019autre.\n\n&quot;&amp;#10;        &quot;Une croix de fixation apparaîtra ensuite. Profitez de ce moment pour &quot;&amp;#10;        &quot;vous remémorer les deux images et pour penser à leur place dans la &quot;&amp;#10;        &quot;séquence que vous avez apprise.\n\n&quot;&amp;#10;        &quot;Vous répondrez ensuite à deux questions à leur sujet.\n\n&quot;&amp;#10;        &quot;[Appuyez sur la touche Entrée pour continuer.]&quot;&amp;#10;    )" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="instruction_part9_text" valType="code" updates="None" name="name"/>
      </CodeComponent>
