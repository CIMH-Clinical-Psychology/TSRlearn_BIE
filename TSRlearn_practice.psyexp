      </TextComponent>
      <CodeComponent name="instruction_part4_text" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    instruction_part4.text = &quot;You will learn the correct associations step by step through trial and feedback.\nAfter each choice, the correct image will replace the current one, and you will then select the next image in the sequence.\n\nTo help you remember the image associations and their order, please imagine a short story that links the images together.\n\n[Press the return key to continue.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;german&quot;)) {&amp;#10;    instruction_part4.text = &quot;Sie lernen die richtigen Assoziationen Schritt f\u00fcr Schritt durch Ausprobieren und Feedback.\nNach jeder Auswahl ersetzt das richtige Bild das aktuelle Bild, und Sie w\u00e4hlen dann das n\u00e4chste Bild in der Reihenfolge aus.\n\nUm sich die Bildassoziationen und ihre Reihenfolge besser merken zu k\u00f6nnen, stellen Sie sich bitte eine kurze Geschichte vor, die die Bilder miteinander verbindet.\n\n[Dr\u00fccken Sie die Eingabetaste, um fortzufahren.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;french&quot;)) {&amp;#10;    instruction_part4.text = &quot;Vous apprendrez les associations correctes \u00e9tape par \u00e9tape gr\u00e2ce \u00e0 des essais et des commentaires.\nApr\u00e8s chaque choix, l'image correcte remplacera l'image actuelle, et vous s\u00e9lectionnerez ensuite l'image suivante dans la s\u00e9quence.\n\nPour vous aider \u00e0 m\u00e9moriser les associations d'images et leur ordre, imaginez une petite histoire qui relie les images entre elles.\n\n[Appuyez sur la touche Entr\u00e9e pour continuer.]&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if language == &quot;english&quot;: &amp;#10;    instruction_part4.text = (&amp;#10;&quot;You will learn the correct associations step by step through trial and feedback.\n&quot;&amp;#10;&quot;After each choice, the correct image will replace the current one, and you will then select the next image in the sequence.\n\n&quot;&amp;#10;&quot;To help you remember the image associations and their order, please imagine a short story that links the images together.\n\n&quot;&amp;#10;&quot;[Press the return key to continue.]&quot;)&amp;#10;&amp;#10;    &amp;#10;    &amp;#10;if language == &quot;german&quot;: &amp;#10;    instruction_part4.text = (&amp;#10;&quot;Sie lernen die richtigen Assoziationen Schritt für Schritt durch Ausprobieren und Feedback.\n&quot;&amp;#10;&quot;Nach jeder Auswahl ersetzt das richtige Bild das aktuelle Bild, und Sie wählen dann das nächste Bild in der Reihenfolge aus.\n\n&quot;&amp;#10;&quot;Um sich die Bildassoziationen und ihre Reihenfolge besser merken zu können, stellen Sie sich bitte eine kurze Geschichte vor, die die Bilder miteinander verbindet.\n\n&quot;&amp;#10;&quot;[Drücken Sie die Eingabetaste, um fortzufahren.]&quot;&amp;#10;)&amp;#10;&amp;#10;if language == &quot;french&quot;:&amp;#10;    instruction_part4.text = (&amp;#10;&quot;Vous apprendrez les associations correctes étape par étape grâce à des essais et des commentaires.\n&quot;&amp;#10;&quot;Après chaque choix, l'image correcte remplacera l'image actuelle, et vous sélectionnerez ensuite l'image suivante dans la séquence.\n\n&quot;&amp;#10;&quot;Pour vous aider à mémoriser les associations d'images et leur ordre, imaginez une petite histoire qui relie les images entre elles.\n\n&quot;&amp;#10;&quot;[Appuyez sur la touche Entrée pour continuer.]&quot;&amp;#10;)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
