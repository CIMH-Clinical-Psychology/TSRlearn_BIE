      </RoutineSettingsComponent>
      <CodeComponent name="controlslider_pos_js" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="&amp;#10;&amp;#10;window.responded_retr_slider = false; " valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="responded_retr_slider = False&amp;#10;delayClock = None&amp;#10;delayDone = False&amp;#10;chosenDis = None&amp;#10;is_correct = False&amp;#10;chosen_num = None&amp;#10;dist_press_onset = None" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="#if slider_main.markerPos is None:&amp;#10;    #possible_positions = [0, 1, 2, 3, 4]&amp;#10;    #slider_main.markerPos = random.choice(possible_positions)&amp;#10;&amp;#10;#slider_main.markerPos = max(0, min(4, slider_main.markerPos))&amp;#10;&amp;#10;# only poll once the component has started AND its flip callbacks have run&amp;#10;if resp_4.status == STARTED and resp_4.tStartRefresh is not None:&amp;#10;    keysPressed = resp_4.getKeys(keyList=[left_key, right_key, center_key, down_key], waitRelease=False)&amp;#10;else:&amp;#10;    keysPressed = []&amp;#10;&amp;#10;if len(keysPressed) &gt; 0 and not responded_retr_slider:&amp;#10;    chosen_key = keysPressed[0]&amp;#10;    if chosen_key.name == left_key:&amp;#10;        chosenDis = 5&amp;#10;        is_dist_corr = (chosenDis == distance_correct)&amp;#10;        if is_dist_corr:&amp;#10;            opt_5.color = &quot;green&quot;&amp;#10;        else:&amp;#10;            opt_5.color = &quot;red&quot;&amp;#10;            &amp;#10;    elif chosen_key.name == right_key:&amp;#10;        chosenDis = 3&amp;#10;        is_dist_corr = (chosenDis == distance_correct)&amp;#10;        if is_dist_corr:&amp;#10;            opt_3.color = &quot;green&quot;&amp;#10;        else:&amp;#10;            opt_3.color = &quot;red&quot;&amp;#10;    elif chosen_key.name == center_key:&amp;#10;        chosenDis = 2&amp;#10;        is_dist_corr = (chosenDis == distance_correct)&amp;#10;        if is_dist_corr:&amp;#10;            opt_2.color = &quot;green&quot;&amp;#10;        else:&amp;#10;            opt_2.color = &quot;red&quot;&amp;#10;    elif chosen_key.name == down_key:&amp;#10;        chosenDis = 4&amp;#10;        is_dist_corr = (chosenDis == distance_correct)&amp;#10;        if is_dist_corr:&amp;#10;            opt_4.color = &quot;green&quot;&amp;#10;        else:&amp;#10;            opt_4.color = &quot;red&quot;&amp;#10;&amp;#10;    resp_4.keys = chosenDis&amp;#10;    resp_4.rt = chosen_key.rt&amp;#10;    resp_4.duration = chosen_key.duration&amp;#10;    resp_4.corr = 1 if chosenDis == distance_correct else 0&amp;#10;&amp;#10;    t_kb_start = resp_4.tStartRefresh&amp;#10;    if t_kb_start is None:&amp;#10;        t_kb_start = resp_4.clock.getLastResetTime()&amp;#10;        print(f&quot;[bids] WARNING: resp_4.tStartRefresh was None (retr_distance), &quot;&amp;#10;              f&quot;using clock reset {t_kb_start:.6f}, frameN={frameN}&quot;)&amp;#10;    dist_press_onset = t_kb_start + chosen_key.rt&amp;#10;&amp;#10;    responded_retr_slider = True&amp;#10;    delayClock = core.Clock()&amp;#10;&amp;#10;if responded_retr_slider and not delayDone and delayClock is not None and delayClock.getTime() &gt;= 0.1:&amp;#10;    delayDone = True&amp;#10;    continueRoutine = False&amp;#10;&amp;#10;#if not responded_retr_slider and retrClock.getTime() &gt;= (retr_dur_slider-1):&amp;#10;    #chooseNowText_3.setOpacity(1)&amp;#10;    &amp;#10;if retrClock.getTime() &gt;= retr_dur_slider and not responded_retr_slider:&amp;#10;    continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if (trial_type === 3 &amp;&amp; !responded_retr_slider) {&amp;#10;    practice_errors += 1;&amp;#10;    resp_2.corr = 0; &amp;#10;}" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="controlslider_pos_js" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="clear_clock_4" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
