      </TextComponent>
      <CodeComponent name="instruction_part5_text" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    instruction_part5.text = &quot;First, you will practice the learning trials.\nThe current image will be shown at the bottom of the screen, and three possible options will appear at the top.\n\nChoose the image you think comes next by pressing the left, center, or right arrow key.\n\n[Press the return key to start the practice trials.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;french&quot;)) {&amp;#10;    instruction_part5.text = &quot;Tout d'abord, vous allez vous entra\u00eener \u00e0 l'aide d'essais d'apprentissage.\nL'image actuelle s'affichera en bas de l'\u00e9cran et trois options possibles appara\u00eetront en haut.\n\nChoisissez l'image qui, selon vous, vient ensuite en appuyant sur la touche fl\u00e9ch\u00e9e gauche, centrale ou droite.\n\n[Appuyez sur la touche Entr\u00e9e pour commencer les essais d'entra\u00eenement.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;german&quot;)) {&amp;#10;    instruction_part5.text = &quot;Zuerst \u00fcben Sie die Lerndurchg\u00e4nge.\nDas aktuelle Bild wird unten auf dem Bildschirm angezeigt, und oben erscheinen drei m\u00f6gliche Optionen.\n\nW\u00e4hlen Sie das Bild, von dem Sie glauben, dass es als n\u00e4chstes kommt, indem Sie die Pfeiltaste nach links, in die Mitte oder nach rechts dr\u00fccken.\n\n[Dr\u00fccken Sie die Eingabetaste, um die \u00dcbungsdurchg\u00e4nge zu starten.]&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if language == &quot;english&quot;: &amp;#10;    instruction_part5.text = (&amp;#10;    &quot;First, you will practice the learning trials.\n&quot;&amp;#10;    &quot;The current image will be shown at the bottom of the screen, and three possible options will appear at the top.\n\n&quot;&amp;#10;    &quot;Choose the image you think comes next by pressing the left, center, or right arrow key.\n\n&quot;&amp;#10;    &quot;[Press the return key to start the practice trials.]&quot;&amp;#10;    )&amp;#10;&amp;#10;if language == &quot;french&quot;:&amp;#10;    instruction_part5.text = (&amp;#10;&quot;Tout d'abord, vous allez vous entraîner à l'aide d'essais d'apprentissage.\n&quot;&amp;#10;&quot;L'image actuelle s'affichera en bas de l'écran et trois options possibles apparaîtront en haut.\n\n&quot;&amp;#10;&quot;Choisissez l'image qui, selon vous, vient ensuite en appuyant sur la touche fléchée gauche, centrale ou droite.\n\n&quot;&amp;#10;&quot;[Appuyez sur la touche Entrée pour commencer les essais d'entraînement.]&quot;&amp;#10;)&amp;#10;&amp;#10;if language == &quot;german&quot;: &amp;#10;    instruction_part5.text = (&amp;#10;&quot;Zuerst üben Sie die Lerndurchgänge.\n&quot;&amp;#10;&quot;Das aktuelle Bild wird unten auf dem Bildschirm angezeigt, und oben erscheinen drei mögliche Optionen.\n\n&quot;&amp;#10;&quot;Wählen Sie das Bild, von dem Sie glauben, dass es als nächstes kommt, indem Sie die Pfeiltaste nach links, in die Mitte oder nach rechts drücken.\n\n&quot;&amp;#10;&quot;[Drücken Sie die Eingabetaste, um die Übungsdurchgänge zu starten.]&quot;&amp;#10;)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
