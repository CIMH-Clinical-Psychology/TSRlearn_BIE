      <CodeComponent name="instruction_part8_text" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    instruction_part8.text = &quot;During practice, the complete sequence will be shown at the bottom of the screen, and you can use it to answer the questions.\n\nThis is only an aid for the practice trials.\nIn the main task the sequence will no longer be shown, and you will have to reconstruct it from memory to answer.\n\n[Press the return key to start the practice trials.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;french&quot;)) {&amp;#10;    instruction_part8.text = &quot;Pendant l'entra\u00eenement, la s\u00e9quence compl\u00e8te sera affich\u00e9e en bas de l'\u00e9cran et vous pourrez l'utiliser pour r\u00e9pondre aux questions.\n\nIl s'agit uniquement d'une aide pour les essais d'entra\u00eenement.\nDans la t\u00e2che principale, la s\u00e9quence ne sera plus affich\u00e9e et vous devrez la reconstruire de m\u00e9moire pour r\u00e9pondre.\n\n[Appuyez sur la touche Entr\u00e9e pour commencer les essais d'entra\u00eenement.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;german&quot;)) {&amp;#10;    instruction_part8.text = &quot;W\u00e4hrend der \u00dcbung wird die vollst\u00e4ndige Sequenz unten auf dem Bildschirm angezeigt, und Sie k\u00f6nnen sie zur Beantwortung der Fragen verwenden.\n\nDies ist nur eine Hilfe f\u00fcr die \u00dcbungsdurchg\u00e4nge.\nIn der Hauptaufgabe wird die Sequenz nicht mehr angezeigt, und Sie m\u00fcssen sie zur Beantwortung aus dem Ged\u00e4chtnis rekonstruieren.\n\n[Dr\u00fccken Sie die Eingabetaste, um die \u00dcbungsdurchg\u00e4nge zu starten.]&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if language == &quot;english&quot;: &amp;#10;    instruction_part8.text = (&amp;#10;    &quot;During practice, the complete sequence will be shown at the bottom of the screen, &quot;&amp;#10;    &quot;and you can use it to answer the questions.\n\n&quot;&amp;#10;    &quot;This is only an aid for the practice trials.\n&quot;&amp;#10;    &quot;In the main task the sequence will no longer be shown, &quot;&amp;#10;    &quot;and you will have to reconstruct it from memory to answer.\n\n&quot;&amp;#10;    &quot;[Press the return key to start the practice trials.]&quot;&amp;#10;    )&amp;#10;if language == &quot;french&quot;:&amp;#10;    instruction_part8.text = (&amp;#10;    &quot;Pendant l'entraînement, la séquence complète sera affichée en bas de l'écran &quot;&amp;#10;    &quot;et vous pourrez l'utiliser pour répondre aux questions.\n\n&quot;&amp;#10;    &quot;Il s'agit uniquement d'une aide pour les essais d'entraînement.\n&quot;&amp;#10;    &quot;Dans la tâche principale, la séquence ne sera plus affichée &quot;&amp;#10;    &quot;et vous devrez la reconstruire de mémoire pour répondre.\n\n&quot;&amp;#10;    &quot;[Appuyez sur la touche Entrée pour commencer les essais d'entraînement.]&quot;&amp;#10;    )&amp;#10;if language == &quot;german&quot;: &amp;#10;    instruction_part8.text = (&amp;#10;    &quot;Während der Übung wird die vollständige Sequenz unten auf dem Bildschirm angezeigt, &quot;&amp;#10;    &quot;und Sie können sie zur Beantwortung der Fragen verwenden.\n\n&quot;&amp;#10;    &quot;Dies ist nur eine Hilfe für die Übungsdurchgänge.\n&quot;&amp;#10;    &quot;In der Hauptaufgabe wird die Sequenz nicht mehr angezeigt, &quot;&amp;#10;    &quot;und Sie müssen sie zur Beantwortung aus dem Gedächtnis rekonstruieren.\n\n&quot;&amp;#10;    &quot;[Drücken Sie die Eingabetaste, um die Übungsdurchgänge zu starten.]&quot;&amp;#10;    )" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="instruction_part8_text" valType="code" updates="None" name="name"/>
      </CodeComponent>
