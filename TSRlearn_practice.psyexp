      <CodeComponent name="instruction_part11_text" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    instruction_part11.text = &quot;First question: the ORDER.\n\nDid the two images appear in the same order as in the learned sequence?\n\nAnswer with the LEFT and RIGHT arrow keys.\n\nThe sides of \u201cyes\u201d and \u201cno\u201d change from trial to trial, so read the labels on the screen before you press.\n\n[Press the return key to continue.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;german&quot;)) {&amp;#10;    instruction_part11.text = &quot;Erste Frage: die REIHENFOLGE.\n\nSind die beiden Bilder in derselben Reihenfolge erschienen wie in der gelernten Sequenz?\n\nAntworten Sie mit der LINKEN und der RECHTEN Pfeiltaste.\n\nDie Seiten von \u201eja\u201c und \u201enein\u201c wechseln von Durchgang zu Durchgang. Lesen Sie deshalb die Beschriftungen auf dem Bildschirm, bevor Sie eine Taste dr\u00fccken.\n\n[Dr\u00fccken Sie die Eingabetaste, um weiterzumachen.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;french&quot;)) {&amp;#10;    instruction_part11.text = &quot;Premi\u00e8re question\u00a0: l\u2019ORDRE.\n\nLes deux images sont-elles apparues dans le m\u00eame ordre que dans la s\u00e9quence apprise\u00a0?\n\nR\u00e9pondez avec les fl\u00e8ches GAUCHE et DROITE.\n\nLes c\u00f4t\u00e9s de \u00ab\u00a0oui\u00a0\u00bb et \u00ab\u00a0non\u00a0\u00bb changent d\u2019un essai \u00e0 l\u2019autre\u00a0: lisez donc les \u00e9tiquettes affich\u00e9es \u00e0 l\u2019\u00e9cran avant d\u2019appuyer.\n\n[Appuyez sur la touche Entr\u00e9e pour continuer.]&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if language == &quot;english&quot;:&amp;#10;    instruction_part11.text = (&amp;#10;        &quot;First question: the ORDER.\n\n&quot;&amp;#10;        &quot;Did the two images appear in the same order as in the learned &quot;&amp;#10;        &quot;sequence?\n\n&quot;&amp;#10;        &quot;Answer with the LEFT and RIGHT arrow keys.\n\n&quot;&amp;#10;        &quot;The sides of \u201cyes\u201d and \u201cno\u201d change from trial to &quot;&amp;#10;        &quot;trial, so read the labels on the screen before you press.\n\n&quot;&amp;#10;        &quot;[Press the return key to continue.]&quot;&amp;#10;    )&amp;#10;&amp;#10;if language == &quot;german&quot;:&amp;#10;    instruction_part11.text = (&amp;#10;        &quot;Erste Frage: die REIHENFOLGE.\n\n&quot;&amp;#10;        &quot;Sind die beiden Bilder in derselben Reihenfolge erschienen wie in &quot;&amp;#10;        &quot;der gelernten Sequenz?\n\n&quot;&amp;#10;        &quot;Antworten Sie mit der LINKEN und der RECHTEN Pfeiltaste.\n\n&quot;&amp;#10;        &quot;Die Seiten von \u201eja\u201c und \u201enein\u201c wechseln von &quot;&amp;#10;        &quot;Durchgang zu Durchgang. Lesen Sie deshalb die Beschriftungen auf &quot;&amp;#10;        &quot;dem Bildschirm, bevor Sie eine Taste drücken.\n\n&quot;&amp;#10;        &quot;[Drücken Sie die Eingabetaste, um weiterzumachen.]&quot;&amp;#10;    )&amp;#10;&amp;#10;if language == &quot;french&quot;:&amp;#10;    instruction_part11.text = (&amp;#10;        &quot;Première question\u00a0: l\u2019ORDRE.\n\n&quot;&amp;#10;        &quot;Les deux images sont-elles apparues dans le même ordre que dans la &quot;&amp;#10;        &quot;séquence apprise\u00a0?\n\n&quot;&amp;#10;        &quot;Répondez avec les flèches GAUCHE et DROITE.\n\n&quot;&amp;#10;        &quot;Les côtés de \u00ab\u00a0oui\u00a0\u00bb et \u00ab\u00a0non\u00a0\u00bb &quot;&amp;#10;        &quot;changent d\u2019un essai à l\u2019autre\u00a0: lisez donc les &quot;&amp;#10;        &quot;étiquettes affichées à l\u2019écran avant d\u2019appuyer.\n\n&quot;&amp;#10;        &quot;[Appuyez sur la touche Entrée pour continuer.]&quot;&amp;#10;    )" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
